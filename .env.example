# Yalnızca üyelik API sunucusunda kullanılır. Bu dosyayı gerçek sırlarla doldurup paylaşmayın.
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=nodera
AUTH_RATE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PORT=8080
HOST=127.0.0.1
# 1 yalnızca API portu dışarıya kapalıysa ve güvenilir tek bir ters proxy varsa kullanılır.
TRUST_PROXY=0
